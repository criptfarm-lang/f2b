# F2B PRO Telegram Bot — шаблон переменных окружения
# Скопируй в .env и подставь свои значения. Не коммить реальный .env в git.

# Telegram
TELEGRAM_BOT_TOKEN=
GROUP_CHAT_IDS=          # через запятую, отрицательные числа: -1001111,-1002222
MANAGER_IDS=             # через запятую, TG-id руководителей чьи сообщения парсим
OWNER_CHAT_ID=           # TG-id владельца бота, гейт админских команд
PARTNER_CHAT_ID=         # TG-id партнёра (Александр), whitelist для /задача

# Claude API
ANTHROPIC_API_KEY=

# Postgres (Railway plugin подставляет автоматически)
DATABASE_URL=

# Яндекс геокодер (для расчётов доставки)
YANDEX_GEOCODER_KEY=

# МойСклад
MOYSKLAD_TOKEN=

# Wazzup (исходящие сообщения клиентам)
WAZZUP_API_KEY=

# Квиз (опционально — если подключён)
QUIZ_BASE_URL=
